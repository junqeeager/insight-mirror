[Unit]
Description=Personal Profile - daily weekly report generation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=junqeeager
WorkingDirectory=/home/junqeeager/aicode
ExecStart=/usr/bin/python3 scripts/generate_report.py --period weekly

