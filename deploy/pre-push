#!/usr/bin/env bash
# pre-push 密钥扫描钩子：检测到真实凭据时阻止推送（fail-closed）。
set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

scanner="${SECRET_SCANNER:-$root/scripts/check_secrets.py}"
if [ ! -f "$scanner" ]; then
    echo "[secret-guard] 未找到扫描脚本 $scanner，已阻止推送。" >&2
    exit 1
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue

    # 删除分支/引用时无需扫描
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # 新分支（远端无对应提交）时扫描全部文件；否则只扫描本次推送变化的文件。
    # 关闭 core.quotePath 并用 NUL 分隔，避免中文/特殊字符文件名被转义后跳过扫描。
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        mapfile -d '' -t file_list < <(git -c core.quotePath=false ls-tree -r --name-only -z "$local_sha")
    else
        mapfile -d '' -t file_list < <(git -c core.quotePath=false diff --name-only --diff-filter=ACMRT -z "$remote_sha".."$local_sha")
    fi

    if [ "${#file_list[@]}" -eq 0 ]; then
        continue
    fi

    if ! python3 "$scanner" --rev "$local_sha" "${file_list[@]}"; then
        echo "[secret-guard] 已阻止推送到 $remote_ref：请移除上述疑似密钥后重新提交/推送。" >&2
        blocked=1
    fi
done

exit "$blocked"
