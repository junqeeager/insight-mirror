[Unit]
Description=Personal Profile React SPA + FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/junqeeager/aicode
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --host 0.0.0.0 --port 8501
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
